[run]
branch = True
source = backend/app, project/src
omit =
    */__pycache__/*
    backend/app/database.py
    backend/app/main.py

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    \.\.\.

[html]
directory = docs/coverage
title = PairEval coverage
