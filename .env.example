# PairEval — environment template.
#
# Names only. Never put a real value in this file: it is committed, and a
# secret that reaches git is compromised even after the commit is deleted.
# Copy to `.env` (git-ignored) and fill it in there.
#
#   cp .env.example .env
#
# If a key does leak, revoking it is the fix. Rewriting history is not.

# --- Database (PRD §11) -----------------------------------------------------
# Dev default is SQLite; production targets PostgreSQL.
#   sqlite:///./paireval.db
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/paireval
DATABASE_URL=

# --- Authentication: Google OAuth 2.0 / OIDC (FR-AUTH-01) -------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Comma-separated hosted domains a login may come from (FR-AUTH-02).
# Leaving this empty must fail closed, not let the whole internet in.
ALLOWED_EMAIL_DOMAINS=

# --- Sessions (FR-AUTH-04, FR-SEC-01) ---------------------------------------
# Random, at least 32 bytes: `python3 -c "import secrets;print(secrets.token_urlsafe(32))"`
SESSION_SECRET=
SESSION_TTL_HOURS=12

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Notifications (FR-NOTIF-01..06) ----------------------------------------
# Message bodies must never carry a score or an evaluator identity (FR-NOTIF-06).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Scoring / pairing defaults (PRD §11.1) ---------------------------------
# Per-assignment overrides live in the database; these are only the fallbacks.
PAIRING_DEFAULT_SEED=
DEFAULT_TARGET_COVERAGE=5
DEFAULT_MAX_WORKLOAD=8
DEFAULT_MIN_COMPARISONS=3
DEFAULT_SCORE_FLOOR=0.600
DEFAULT_SCORE_CEILING=1.000
DEFAULT_COMPLETION_THRESHOLD=0.900

# --- E2E --------------------------------------------------------------------
BASE_URL=http://localhost:5173
